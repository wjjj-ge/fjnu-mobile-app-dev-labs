<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <include
        android:id="@+id/header"
        layout="@layout/view_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/card_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- 顶部三页签：图标 + 文字，等权重 -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="@drawable/tab_bar_top"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/space_station_icon"
                    android:contentDescription="@string/tab_station" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tab_station"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/tab_flights"
                    android:src="@drawable/rocket_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tab_flights"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/tab_rovers"
                    android:src="@drawable/rover_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tab_rovers"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 出发地 / 目的地：两块绿底，中间白色方框叠在接缝上 -->
        <FrameLayout
            android:id="@+id/cityRow"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/block_green"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:text="@string/city_dca"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/block_green"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:text="@string/city_mars"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_white"
                android:contentDescription="swap"
                android:elevation="3dp"
                android:padding="8dp"
                android:src="@drawable/double_arrows" />
        </FrameLayout>

        <!-- One Way 开关条 -->
        <LinearLayout
            android:id="@+id/oneWayBar"
            android:layout_width="200dp"
            android:layout_height="34dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/chip_orange"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cityRow">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/one_way"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <View
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:background="@drawable/circle_white" />
        </LinearLayout>

        <TextView
            android:id="@+id/travellerChip"
            android:layout_width="120dp"
            android:layout_height="30dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/chip_orange_soft"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="@string/traveller"
            android:textColor="@color/white"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/oneWayBar" />

        <!-- 星球主视觉 -->
        <ImageView
            android:id="@+id/planet"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:contentDescription="planet"
            android:scaleType="fitCenter"
            android:src="@drawable/galaxy"
            app:layout_constraintBottom_toTopOf="@id/btnDepart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/travellerChip"
            app:layout_constraintVertical_bias="0.5" />

        <ImageView
            android:id="@+id/rocket"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="rocket"
            android:src="@drawable/rocket_icon"
            android:translationY="18dp"
            app:layout_constraintBottom_toBottomOf="@id/planet"
            app:layout_constraintEnd_toStartOf="@id/planet" />

        <TextView
            android:id="@+id/btnDepart"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:background="@drawable/depart_bottom"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:text="@string/depart"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
