<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lab3Components">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ListViewActivity"
            android:exported="false"
            android:label="@string/nav_01_title" />

        <activity
            android:name=".DialogActivity"
            android:exported="false"
            android:label="@string/nav_02_title" />

        <activity
            android:name=".MenuActivity"
            android:exported="false"
            android:label="@string/nav_03_title" />

        <activity
            android:name=".ActionModeActivity"
            android:exported="false"
            android:label="@string/nav_04_title" />

        <activity
            android:name=".RecyclerActivity"
            android:exported="false"
            android:label="@string/nav_05_title" />

    </application>

</manifest>
